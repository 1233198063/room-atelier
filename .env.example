# Copy to .env and fill in. Read by `npm run dev:server` and `npm start`.

# Reads floor plan images (Import a floor plan). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: the model that reads plans (default claude-opus-5).
# FLOOR_PLAN_MODEL=claude-opus-5

# Optional: the server's port (default 5181; Vite proxies /api to it in development).
# PORT=5181

# Development only: answer every floor plan with a saved reading (JSON) instead of calling the API.
# FLOOR_PLAN_MOCK=path/to/reading.json
