# Copy to .env if you need to change anything. Read by `npm run dev:server` and `npm start`.

# Who reads floor plans (Import a floor plan):
#   codex  (default) the Codex CLI on this machine, signed in with your ChatGPT account; no API key.
#          Found on PATH or inside the OpenAI extension for VS Code / Cursor.
#   claude the Claude API; needs ANTHROPIC_API_KEY.
# FLOOR_PLAN_PROVIDER=codex

# Optional, Codex: the executable to use, and a model to ask for (default: your Codex config).
# CODEX_PATH=C:\path\to\codex.exe
# FLOOR_PLAN_CODEX_MODEL=
# FLOOR_PLAN_TIMEOUT_MS=300000

# Claude only: an API key from https://console.anthropic.com/, and the model (default claude-opus-5).
# ANTHROPIC_API_KEY=
# FLOOR_PLAN_MODEL=claude-opus-5

# Optional: the server's port (default 5181; Vite proxies /api to it in development).
# PORT=5181

# Development only: answer every floor plan with a saved reading (JSON) instead of calling a model.
# FLOOR_PLAN_MOCK=path/to/reading.json
